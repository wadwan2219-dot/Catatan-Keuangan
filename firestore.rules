rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Koleksi Pengguna (Users)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Koleksi Kas Bersama: Tabungan (Pemasukan)
    match /tabungan/{tabunganId} {
      allow read, write: if request.auth != null;
    }

    // 3. Koleksi Kas Bersama: Belanja (Pengeluaran)
    match /belanja/{belanjaId} {
      allow read, write: if request.auth != null;
    }

    // 4. Koleksi Grup & Ledger Hutang Bersih (Iwan & Wadda)
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /debtEntries/{entryId} {
        // Anggota terautentikasi dapat membaca riwayat ledger
        allow read: if request.auth != null;

        // Hanya mengizinkan penambahan entri baru (Append-Only)
        allow create: if request.auth != null
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 1000000000
          && request.resource.data.kind in ['debt', 'payment', 'reversal']
          && request.resource.data.createdByUid == request.auth.uid;

        // DILARANG keras hard update atau hard delete agar jejak audit keuangan terjaga
        allow update, delete: if false;
      }
    }
  }
}
